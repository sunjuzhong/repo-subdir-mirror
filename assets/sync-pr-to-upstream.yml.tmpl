name: Sync a mirror PR to upstream branch

# 手动触发：输入本镜像仓库的一个 PR 号，把该 PR 相对 main 的改动
# 套用到上游 __UPSTREAM_REPO__ 的 __TARGET_DIR__ 目录下，推送到上游的一个新分支。
# 只会推送到上游的“新分支”，不会改上游的 __UPSTREAM_BRANCH__，之后由你去开 PR。
on:
  workflow_dispatch:
    inputs:
      pr_number:
        description: "镜像仓库中的 PR 号"
        required: true
        type: string
      target_branch:
        description: "上游目标分支名（留空 = 自动 pr-<PR号>-<短SHA>）"
        required: false
        type: string

permissions:
  contents: read
  pull-requests: read

concurrency:
  group: sync-pr-to-upstream-${{ inputs.pr_number }}
  cancel-in-progress: false

jobs:
  sync:
    runs-on: ubuntu-latest
    env:
      MIRROR_BRANCH: __MIRROR_BRANCH__
      UPSTREAM_REPO: __UPSTREAM_REPO__
      UPSTREAM_BRANCH: __UPSTREAM_BRANCH__
      PREFIX: __TARGET_DIR__
    steps:
      - name: Checkout mirror repo
        uses: actions/checkout@v4
        with:
          fetch-depth: 1

      - name: Free up disk space
        run: |
          set -euo pipefail
          echo "Disk before:"; df -h /
          sudo rm -rf /usr/share/dotnet
          sudo rm -rf /opt/ghc
          sudo rm -rf /opt/hostedtoolcache/CodeQL
          sudo rm -rf /usr/local/share/boost
          sudo rm -rf /usr/local/lib/android
          sudo apt-get clean
          echo "Disk after:"; df -h /

      - name: Build patch from the mirror PR
        env:
          GH_TOKEN: ${{ secrets.GITHUB_TOKEN }}
          PR: ${{ inputs.pr_number }}
        run: |
          set -euo pipefail
          TITLE=$(gh pr view "$PR" --repo "${{ github.repository }}" --json title --jq .title)
          echo "PR_TITLE=$TITLE" >> "$GITHUB_ENV"

          # 拉取镜像 main 与 PR head 两个 ref，按“两棵树直接 diff”得到净改动，
          # 不依赖 merge-base（镜像 main 每天被 force 重置，历史对不上）。
          git fetch --no-tags origin \
            "+refs/heads/${MIRROR_BRANCH}:refs/remotes/origin/${MIRROR_BRANCH}" \
            "pull/${PR}/head:refs/remotes/origin/pr/${PR}"

          SHORT_SHA=$(git rev-parse --short "refs/remotes/origin/pr/${PR}")
          echo "SHORT_SHA=$SHORT_SHA" >> "$GITHUB_ENV"

          # 排除镜像专用文件，上游不感知镜像配置。
          EXCLUDES=(
            ':(exclude)SUBTREE_PR.md'
            ':(exclude).github/workflows/sync-upstream.yml'
            ':(exclude).github/workflows/sync-pr-to-upstream.yml'
          )
          git diff --binary "origin/${MIRROR_BRANCH}" "refs/remotes/origin/pr/${PR}" \
            -- . "${EXCLUDES[@]}" > /tmp/pr.patch

          if [ ! -s /tmp/pr.patch ]; then
            echo "::error::PR #${PR} 相对 ${MIRROR_BRANCH} 没有可同步的改动（补丁为空）。"
            exit 1
          fi
          echo "Patch size: $(wc -c < /tmp/pr.patch) bytes"

      - name: Apply to upstream subdirectory and push a branch
        env:
          UPSTREAM_TOKEN: ${{ secrets.UPSTREAM_TOKEN }}
        run: |
          set -euo pipefail
          PR="${{ inputs.pr_number }}"
          BRANCH="${{ inputs.target_branch }}"
          if [ -z "$BRANCH" ]; then
            BRANCH="pr-${PR}-${SHORT_SHA}"
          fi

          if [ -z "${UPSTREAM_TOKEN:-}" ]; then
            echo "::error::未配置 UPSTREAM_TOKEN secret，无法推送到上游。"
            exit 1
          fi

          # 稀疏克隆：只取目标子目录，节省磁盘与时间。
          git clone --filter=blob:none --sparse --depth 1 --branch "${UPSTREAM_BRANCH}" \
            "https://x-access-token:${UPSTREAM_TOKEN}@github.com/${UPSTREAM_REPO}.git" /tmp/upstream
          cd /tmp/upstream
          git sparse-checkout set "${PREFIX}"
          git switch -c "${BRANCH}"

          # --directory 给补丁所有路径加上子目录前缀，把镜像根树铺回上游子目录。
          if ! git apply --whitespace=nowarn --directory="${PREFIX}" /tmp/pr.patch; then
            echo "::error::补丁无法应用到上游 ${PREFIX}。上游可能已变更，请先 rebase 你的镜像分支后重试。"
            exit 1
          fi

          git add -A "${PREFIX}"
          if git diff --cached --quiet; then
            echo "::error::应用补丁后没有产生改动（可能与上游已一致）。"
            exit 1
          fi

          git -c user.email="41898282+github-actions[bot]@users.noreply.github.com" \
              -c user.name="github-actions[bot]" \
              commit -m "feat: ${PR_TITLE} (mirror PR #${PR})"

          git push origin "${BRANCH}"

          COMPARE="https://github.com/${UPSTREAM_REPO}/compare/${UPSTREAM_BRANCH}...${BRANCH}?expand=1"
          {
            echo "## 已推送到上游新分支"
            echo ""
            echo "- 上游仓库：\`${UPSTREAM_REPO}\`"
            echo "- 新分支：\`${BRANCH}\`"
            echo "- 源镜像 PR：#${PR} —— ${PR_TITLE}"
            echo ""
            echo "去开 PR：${COMPARE}"
          } >> "$GITHUB_STEP_SUMMARY"
